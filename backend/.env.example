
# --- Profile picture storage (S3 or S3-compatible). Leave S3_BUCKET empty to use local disk. ---
S3_BUCKET=
AWS_REGION=eu-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: S3-compatible provider (Cloudflare R2, MinIO, ...)
S3_ENDPOINT_URL=
# Optional: public/CDN base URL (e.g. CloudFront). Defaults to https://<bucket>.s3.<region>.amazonaws.com
S3_PUBLIC_BASE_URL=
